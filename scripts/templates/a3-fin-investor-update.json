    {
     "kind": "text",
     "x": 84,
     "y": 530,
     "w": 297,
     "h": 70,
     "spans": [
      {
       "text": "Brightwater signed. ",
       "weight": 700,
       "color": "#201C17"
      },
      {
       "text": "A 41-store group and our largest contract yet, worth $186K a year over three years."
      }
     ],
     "family": "EB Garamond",
     "size": 14.5,
     "weight": 400,
     "color": "#2E2923",
     "lineHeight": 1.46
    },
    {
     "kind": "text",
     "x": 84,
     "y": 614,
     "w": 297,
     "h": 70,
     "spans": [
      {
       "text": "Reconciliation shipped. ",
       "weight": 700,
       "color": "#201C17"
      },
      {
       "text": "Automated controlled-drug reconciliation went live, and 60% of customers switched it on within three weeks."
      }
     ],
     "family": "EB Garamond",
     "size": 14.5,
     "weight": 400,
     "color": "#2E2923",
     "lineHeight": 1.46
    },
    {
     "kind": "text",
     "x": 84,
     "y": 698,
     "w": 297,
     "h": 70,
     "spans": [
      {
       "text": "A VP of Engineering. ",
       "weight": 700,
       "color": "#201C17"
      },
      {
       "text": "Tomasz Wren joins on 1 December from a logistics scale-up, where he led a team of forty."
      }
     ],
     "family": "EB Garamond",
     "size": 14.5,
     "weight": 400,
     "color": "#2E2923",
     "lineHeight": 1.46
    },
    {
     "kind": "text",
     "x": 413,
     "y": 486,
     "w": 297,
     "h": 28,
     "text": "What did not",
     "family": "EB Garamond",
     "size": 21,
     "weight": 600,
     "color": "#201C17"
    },
    {
     "kind": "rect",
     "x": 413,
     "y": 517,
     "w": 297,
     "h": 1,
     "fill": "#201C17"
    },
    {
     "kind": "text",
     "x": 413,
     "y": 530,
     "w": 297,
     "h": 70,
     "spans": [
      {
       "text": "We lost Northgate Health. ",
       "weight": 700,
       "color": "#201C17"
      },
      {
       "text": "Our largest pilot chose an incumbent on price. We were too slow to quote a multi-year deal, and that is on me."
      }
     ],
     "family": "EB Garamond",
     "size": 14.5,
     "weight": 400,
     "color": "#2E2923",
     "lineHeight": 1.46
    },
    {
     "kind": "text",
     "x": 413,
     "y": 614,
     "w": 297,
     "h": 70,
     "spans": [
      {
       "text": "Onboarding is too slow. ",
       "weight": 700,
       "color": "#201C17"
      },
      {
       "text": "New customers take 34 days to go live against a 21-day target. Two implementation roles are still open."
      }
     ],
     "family": "EB Garamond",
     "size": 14.5,
     "weight": 400,
     "color": "#2E2923",
     "lineHeight": 1.46
    },
    {
     "kind": "text",
     "x": 413,
     "y": 698,
     "w": 297,
     "h": 70,
     "spans": [
      {
       "text": "Sales cycles are longer. ",
       "weight": 700,
       "color": "#201C17"
      },
      {
       "text": "Median time to close rose from 48 to 61 days as we sell to larger groups. We have not yet adapted the process."
      }
     ],
     "family": "EB Garamond",
     "size": 14.5,
     "weight": 400,
     "color": "#2E2923",
     "lineHeight": 1.46
    },
