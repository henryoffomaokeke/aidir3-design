    {
     "kind": "text",
     "x": 60,
     "y": 394,
     "w": 410,
     "h": 80,
     "text": "Brightwell bills 14,000 customers across nine countries, each on negotiated rates. One invoice in eight was disputed, usually over fuel surcharges applied by hand, and finance spent 900 hours a month resolving them.",
     "family": "DM Sans",
     "size": 12.5,
     "weight": 400,
     "color": "#46544C",
     "lineHeight": 1.6
    },
    {
     "kind": "text",
     "x": 60,
     "y": 499,
     "w": 24,
