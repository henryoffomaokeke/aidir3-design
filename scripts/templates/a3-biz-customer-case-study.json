     "text": "02",
     "family": "DM Sans",
     "size": 10.5,
     "weight": 700,
     "color": "#9A6B12",
     "letterSpacing": 1
    },
    {
     "kind": "text",
     "x": 88,
     "y": 491,
     "w": 300,
     "h": 28,
     "text": "Solution",
     "family": "DM Serif Display",
     "size": 22,
     "weight": 400,
     "color": "#0F3D2E"
    },
    {
     "kind": "text",
     "x": 60,
     "y": 526,
     "w": 410,
     "h": 80,
     "text": "Corvane Billing now prices every shipment from the signed rate card and attaches the proof of delivery to the invoice. Reconcile matches payments overnight and routes the exceptions to the right account manager.",
     "family": "DM Sans",
     "size": 12.5,
     "weight": 400,
     "color": "#46544C",
     "lineHeight": 1.6
    },
    {
