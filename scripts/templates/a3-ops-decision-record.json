    {
     "kind": "text",
     "x": 64,
     "y": 402,
     "w": 320,
     "h": 80,
     "text": "Finance, support and analytics read orders and billing data from exports that run at 02:00. By the afternoon that data is up to fourteen hours old, and support agents quote balances customers have already paid.",
     "family": "Libre Baskerville",
     "size": 11,
     "weight": 500,
     "color": "#1B1B18",
     "lineHeight": 1.62
    },
    {
     "kind": "text",
     "x": 410,
     "y": 402,
     "w": 320,
     "h": 80,
     "text": "The export also holds long read locks on the primary. It has overrun into the morning peak four times this quarter, and each overrun slowed checkout. Three teams have asked for fresher data since June.",
     "family": "Libre Baskerville",
     "size": 11,
     "weight": 500,
     "color": "#1B1B18",
     "lineHeight": 1.62
    },
